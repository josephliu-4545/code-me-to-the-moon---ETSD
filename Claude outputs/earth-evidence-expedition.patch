+.readout-evidence.level-increasing::before, .readout-evidence.level-decreasing::before { background: var(--aurora-teal); }
+.readout-evidence .ev-value { font-family: var(--font-display); font-size: 1.9rem; font-weight: 500; }
+.readout-na { margin-top: 10px; padding-top: 10px; border-top: 1px dashed var(--xp-line); }
+.readout-years::before { background: var(--atmosphere-cyan); }
