+/* ==========================================================================
+   Earth Evidence Expedition — discovery, evidence explorer, scientific guardrails.
+   Graphics here explain: grids show footprints, orbits connect evidence, pips show months.
+   ========================================================================== */
+
+.findings {
+  --chart-focus: var(--aurora-teal);
+  --xp-glass: linear-gradient(150deg, rgba(22, 34, 72, .78), rgba(6, 12, 29, .9));
+  --xp-line: rgba(146, 166, 232, .3);
+  --xp-line-strong: rgba(146, 166, 232, .55);
+  --xp-ok: var(--aurora-teal);
+  --xp-limited: var(--celestial-peach);
+  --xp-off: #8d9bbb;
+}
+
+/* ---------- Experience A: discovery ---------- */
+.discovery-headline { max-width: 17ch; }
+.discovery-qualifier {
+  max-width: 46ch; font-size: clamp(1.05rem, .95rem + .4vw, 1.3rem); line-height: 1.45; color: var(--moonlight-warm);
+  padding-left: 14px; border-left: 2px solid var(--celestial-peach);
+}
+.qualifier-increasing, .qualifier-decreasing { border-left-color: var(--aurora-teal); }
+.qualifier-unavailable { border-left-style: dotted; }
+
+.readout-deck { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr) minmax(0, 1fr); gap: 18px; align-items: stretch; }
+.readout { position: relative; display: grid; align-content: start; gap: 4px; padding: 22px 22px 20px; min-width: 0; border: 1px solid var(--xp-line); background: var(--xp-glass); border-radius: 4px 24px 4px 24px; overflow: hidden; }
+.readout::before { content: ""; position: absolute; inset: 0 auto auto 0; width: 54px; height: 2px; background: var(--cosmic-indigo); }
+.readout-q { font: 500 .7rem var(--font-mono); letter-spacing: .14em; text-transform: uppercase; color: #a9b8e6; margin-bottom: 8px; }
+.readout .figure-label { font: 600 var(--fs-xs) var(--font-brand); color: #c9d3ef; letter-spacing: .04em; }
+.readout-rate { background: radial-gradient(ellipse at 100% 0%, rgba(143,100,232,.32), transparent 55%), var(--xp-glass); }
+.readout-rate .figure-value { font-size: clamp(2.6rem, 3.6vw, 4.2rem); line-height: 1; color: var(--starlight); }
+.readout-rate .figure-unit { color: #c6d1ec; }
