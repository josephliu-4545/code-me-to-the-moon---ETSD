# Earth System Trend Detective backend configuration.
#
# Local development: copy this file to backend/.env and set EE_PROJECT_ID. Never commit .env.
# Production (container / Cloud Run): set these as environment variables or platform secrets
# instead of a .env file; the image contains no .env. See DEPLOYMENT.md at the repository root.
#
# Every setting is listed. Lines starting with "#" show the built-in default and change nothing.
# Uncomment a line only when you need a different value.

# ---------------------------------------------------------------------------------------------
# Earth Engine (needed for NDVI, precipitation and soil moisture; NASA POWER variables work without it)
# ---------------------------------------------------------------------------------------------
# Google Cloud project registered for Earth Engine.
EE_PROJECT_ID=your-google-cloud-project-id

# Credentials. Choose ONE mode; configuring both a key file and ADC is rejected at start-up.
#  1. Default (nothing set): your own `earthengine authenticate` credentials (local development).
#     If none exist, the Earth Engine library falls back to Application Default Credentials.
#  2. Keyless (recommended on Cloud Run): use the service account attached to the service through
#     Google Application Default Credentials. No key file anywhere.
# EE_USE_APPLICATION_DEFAULT_CREDENTIALS=false
#  3. Service-account key file, only where keyless identity is unavailable. Store the JSON key
#     OUTSIDE the repository (for example a mounted secret) and never bake it into an image.
# EE_SERVICE_ACCOUNT_KEY_FILE=

# Concurrency and time limits for Earth Engine work.
# EE_MAX_CONCURRENT_OPERATIONS=2
# EE_REQUEST_TIMEOUT_SECONDS=60.0
# Seconds a request waits for a free Earth Engine / NASA POWER slot before answering 503 "busy".
# OPERATION_QUEUE_TIMEOUT_SECONDS=20.0

# ---------------------------------------------------------------------------------------------
# Serving, access control and client identification
# ---------------------------------------------------------------------------------------------
# Built frontend (frontend/dist) served at /app/ by this backend (single origin). The container sets it.
# FRONTEND_DIST_DIR=
# Port: the container listens on $PORT (Cloud Run provides it; default 8080). Not read by the app itself.
# PORT=8080
# Browser origins allowed to call the API from another origin. Not needed for single-origin hosting.
# CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Comma-separated team access keys. When set, /api/* (except /api/v2/status) needs an X-API-Key header.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(24))". Store as a secret.
# API_KEYS=
# Requests per minute per client (API key, else IP). 0 disables. Comparisons cost 3.
# RATE_LIMIT_PER_MINUTE=0

# Client addresses come from the direct connection. X-Forwarded-For is client-controlled and is used
# ONLY when TRUST_PROXY_HEADERS=true AND the direct peer is in TRUSTED_PROXY_IPS. The client address is
# then read TRUSTED_PROXY_HOPS entries from the right (the entry written by your outermost proxy).
# TRUSTED_PROXY_IPS: comma-separated IPs/CIDRs of your reverse proxies, or "*" only on a platform whose
# ingress always passes through its own proxy (verify this for your platform; see DEPLOYMENT.md).
# Misconfiguration (empty list, invalid entry, hops < 1) is reported by /api/v2/status and the headers
# are ignored, so clients are never identified by unverified header text.
# TRUST_PROXY_HEADERS=false
# TRUSTED_PROXY_IPS=
# TRUSTED_PROXY_HOPS=1

# ---------------------------------------------------------------------------------------------
# Result caches (in memory, per process; lost on restart)
# ---------------------------------------------------------------------------------------------
# UNIFIED_CACHE_MAX_ENTRIES=128
# UNIFIED_CACHE_TTL_SECONDS=3600.0
# PRECIPITATION_CACHE_MAX_ENTRIES=32
# PRECIPITATION_CACHE_TTL_SECONDS=3600.0
# SOIL_MOISTURE_CACHE_MAX_ENTRIES=32
# SOIL_MOISTURE_CACHE_TTL_SECONDS=3600.0
# HEAT_REFERENCE_CACHE_MAX_ENTRIES=16

# ---------------------------------------------------------------------------------------------
# Data provider limits and timeouts
# ---------------------------------------------------------------------------------------------
# POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal
# POWER_HTTP_TIMEOUT_SECONDS=30.0
# POWER_REQUEST_TIMEOUT_SECONDS=60.0
# POWER_MAX_CONCURRENT_OPERATIONS=2
# POWER_MAX_DATE_RANGE_YEARS=50
# POWER_WINDOW_YEARS=10
# NDVI_MAX_RADIUS_KM=100.0
# NDVI_MAX_DATE_RANGE_YEARS=10
# NDVI_TREND_MAX_DATE_RANGE_YEARS=30
# PRECIPITATION_MAX_DATE_RANGE_YEARS=30
# PRECIPITATION_WINDOW_YEARS=5
# PRECIPITATION_REGION_MAX_SPAN_DEGREES=5.0
# SOIL_MOISTURE_MAX_DATE_RANGE_YEARS=27
# SOIL_MOISTURE_WINDOW_YEARS=5
# SOIL_MOISTURE_SMAP_WINDOW_YEARS=2
# SOIL_MOISTURE_MAX_PARALLEL_WINDOWS=5
# Soil-moisture requests can take this long; the hosting request timeout must be longer.
# SOIL_MOISTURE_REQUEST_TIMEOUT_SECONDS=180.0

# ---------------------------------------------------------------------------------------------
# Scientific policy (project policies; changing them changes results for every user)
# ---------------------------------------------------------------------------------------------
# Leave these at their defaults in production. Any change must be agreed by the team, documented
# in a pull request, and tested (see README "Team collaboration").
# ANNUAL_MIN_REPRESENTED_MONTHS=9
# ANNUAL_MIN_VALID_COVERAGE=0.7
# ANNUAL_REQUIRE_ALL_QUARTERS=true
# ANNUAL_EXCLUDE_PARTIAL_YEARS=true
# Optional minimum per-observation spatial coverage (percent); unset means no extra filter.
# ANNUAL_MIN_OBSERVATION_SPATIAL_COVERAGE=
# TREND_MIN_SLOPE_YEARS=3
# TREND_MIN_SIGNIFICANCE_YEARS=8
# TREND_SIGNIFICANCE_ALPHA=0.05
# TREND_MIN_ADJACENT_PAIRS=6
# TREND_MATERIAL_LAG1_RHO=0.3
# RH_MIN_ANNUAL_COVERAGE=0.9
# RH_MIN_MONTHLY_COVERAGE=0.8
# HEAT_REFERENCE_START_YEAR=1991
# HEAT_REFERENCE_END_YEAR=2020
# HEAT_REFERENCE_MINIMUM_WINDOW_FRACTION=0.75
# HEAT_MAXIMUM_MISSING_DAYS_PER_YEAR=15
# HEAT_MAXIMUM_MISSING_DAYS_PER_MONTH=3
# PRECIPITATION_MIN_VALID_MONTHS=12
# PRECIPITATION_REGION_MIN_VALID_AREA_FRACTION=0.95
# SOIL_MOISTURE_GLDAS_MIN_MONTH_SLOT_COVERAGE=0.9
# SOIL_MOISTURE_GLDAS_EXCLUDE_RECENT_MONTHS=4
# SOIL_MOISTURE_SMAP_MIN_VALID_DAYS_PER_MONTH=8
# SOIL_MOISTURE_SMAP_MIN_VALID_DAYS_PER_THIRD=1
# SOIL_MOISTURE_COMPARE_MIN_OVERLAP_MONTHS=36

# ---------------------------------------------------------------------------------------------
# Mission Scientist chatbot (optional)
# ---------------------------------------------------------------------------------------------
# Free-tier Gemini API key; leave unset to disable the chatbot. Keep it secret, backend only.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_TIMEOUT_SECONDS=90

# ---------------------------------------------------------------------------------------------
# Service identity
# ---------------------------------------------------------------------------------------------
# APP_NAME=NASA Earth System Trend Detective API
# APP_VERSION=0.1.0
